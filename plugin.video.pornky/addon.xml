<addon id="plugin.video.pornky"
    name="Pornky Extra"
    version="1.0.4"
    provider-name="Habib">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <!-- Plugin -->
    <extension
        point="xbmc.python.pluginsource"
        library="default.py">

        <provides>video</provides>

    </extension>

    <!-- Metadata -->
    <extension point="xbmc.addon.metadata">

        <summary lang="en">
            Stream videos from XML playlists
        </summary>

        <description lang="en">
            A flexible Kodi addon that streams video content from XML files.
        </description>

        <platform>all</platform>

        <license>MIT</license>

        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>

    </extension>

</addon>