<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.elementumorg" name="ElementumOrg repository" provider-name="elementumorg" version="0.0.7">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.addon.repository">
        <!-- ARM 64 (Omega/Pornky path) -->
        <dir>
            <info>https://raw.githubusercontent.com/Habib4326/Kodi-Pornky/main/omega/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/Habib4326/Kodi-Pornky/main/omega/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/Habib4326/Kodi-Pornky/main/omega/zips/</datadir>
        </dir>
    </extension>

    <extension point="xbmc.python.script" library="default.py"/>
    <extension point="xbmc.service" library="service.py"/>

    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <source>https://github.com/ElementumOrg/repository.elementumorg</source>
        <summary lang="en">GitHub virtual Add-on repository</summary>
        <description lang="en">Customizable repository for ARM and ARM64 architecture support.</description>
        <news>
            - Added support for multiple repository directories
            - Optimized for ARM and ARM64 structures
            - Standalone mode improvements
        </news>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>