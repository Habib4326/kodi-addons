<?xml version="1.0" encoding="utf-8"?>
<addon id="plugin.video.codexfinder"
       name="[B][COLOR deepskyblue]ICC[/COLOR] [COLOR white]Movies FTP[/COLOR][/B]"
       version="1.0.10"
       provider-name="Habib">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>

    <extension point="xbmc.addon.metadata">

        <summary lang="en">
            Browse and stream movies from ICC Movies Database
        </summary>

        <description lang="en">
            Stream movies directly from organized online databases and server links.
        </description>

        <platform>all</platform>

        <license>MIT</license>

        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>

    </extension>
</addon>