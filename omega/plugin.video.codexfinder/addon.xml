<addon id="plugin.video.codexfinder"
       name="ICC Movies FTP"
       version="1.0.6"
       provider-name="Habib">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>

    <extension point="xbmc.addon.metadata">

        <summary lang="en">
            Browse and stream movies from FTP servers
        </summary>

        <description lang="en">
            Stream movies directly from local FTP/IP servers
        </description>

        <platform>all</platform>

        <license>MIT</license>

        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>

    </extension>

</addon>